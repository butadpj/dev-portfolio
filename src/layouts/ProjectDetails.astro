---
import Layout from "./Root.astro";
import Navbar from "../sharedComponents/Navbar/Navbar";
import Footer from "../components/Footer.astro";
import { buttonVariants } from "../components/ui/button";
import { FiArrowLeft, FiArrowUpRight, FiGithub } from "solid-icons/fi";
import { formatDate } from "../utils";

interface Props {
  title: string;
  description: string;
  swiperBgImage?: string;
  swiperSlides?: Array<{ title: string; description: string }>;
  tags?: string[];
  buttons: {
    repoButton: { text: string; url: string };
    liveDemoButton?: { text: string; url: string };
  };
  technologies: Array<{ title: string; description: string }>;
  pubDate?: Date;
}
const {
  title,
  description,
  swiperBgImage,
  swiperSlides = [],
  tags = [],
  buttons,
  technologies = [],
  pubDate,
} = Astro.props;
---

<Layout
  title={`${title} · Paul John Butad`}
  description={description}
  ogMeta={{ image: swiperBgImage }}
>
  <Navbar client:load />
  <main id="main-content" tabindex="-1" class="site-container detail-main">
    <a class="text-link detail-back" href="/#projects"
      ><FiArrowLeft aria-hidden="true" /> Back to work</a
    >
    <header class="detail-heading">
      <p class="eyebrow section-index">
        From the project archive {
          pubDate && (
            <>
              <>
                <span aria-hidden="true">/</span>
                <time datetime={pubDate.toISOString()}>
                  {formatDate(pubDate)}
                </time>
              </>
            </>
          )
        }
      </p><h1>{title}</h1><p class="detail-description">{description}</p><ul
        class="tag-list"
        aria-label="Project focus"
      >
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    {
      swiperBgImage && (
        <img
          class="detail-image"
          src={swiperBgImage}
          alt={`${title} website preview`}
          width="1200"
          height="675"
        />
      )
    }
    <div class="project-body">
      {
        swiperSlides.length > 0 && (
          <div class="project-notes">
            {swiperSlides.map((slide) => (
              <section>
                <h2>{slide.title}</h2>
                <p>{slide.description}</p>
              </section>
            ))}
          </div>
        )
      }
      <article class="prose dark:prose-invert"><slot /></article>
      <div class="project-actions">
        <a
          class={buttonVariants({ variant: "outline" })}
          href={buttons.repoButton.url}
          target="_blank"
          rel="noreferrer"
          >{buttons.repoButton.text} <FiGithub aria-hidden="true" /></a
        >{
          buttons.liveDemoButton && (
            <a
              class={buttonVariants()}
              href={buttons.liveDemoButton.url}
              target="_blank"
              rel="noreferrer"
            >
              {buttons.liveDemoButton.text}{" "}
              <FiArrowUpRight aria-hidden="true" />
            </a>
          )
        }
      </div>
      {
        technologies.length > 0 && (
          <section class="technology-list" aria-labelledby="technologies-title">
            <>
              <h2 id="technologies-title">Built with</h2>
              <ul>
                {technologies.map((technology) => (
                  <li>
                    <strong>{technology.title}</strong> ·{" "}
                    {technology.description}
                  </li>
                ))}
              </ul>
            </>
          </section>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>
