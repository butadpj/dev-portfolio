---
import Layout from "./Root.astro";
import Navbar from "../sharedComponents/Navbar/Navbar";
import Footer from "../components/Footer.astro";
import { FiArrowLeft } from "solid-icons/fi";
import { formatDate } from "../utils";

interface Props {
  title: string;
  description: string;
  tags?: string[];
  pubDate?: Date;
  backgroundImage?: string;
  isDraft?: boolean;
}
const {
  title,
  description,
  tags = [],
  pubDate,
  backgroundImage,
  isDraft,
} = Astro.props;
---

<Layout
  title={`${title} · butadpj`}
  description={description}
  ogMeta={{ title, image: backgroundImage }}
>
  <Navbar client:load />
  {
    isDraft && (
      <p class="draft-notice">
        This is a draft. Still figuring this one out 😅
      </p>
    )
  }
  <main
    id="main-content"
    tabindex="-1"
    class="site-container detail-main article-main"
  >
    <a class="text-link detail-back" href="/#learn"
      ><FiArrowLeft aria-hidden="true" /> Back to writing</a
    >
    <header class="detail-heading">
      <p class="eyebrow section-index">
        Notes by Paul {
          pubDate && (
            <>
              <>
                <span aria-hidden="true">/</span>
                <time datetime={pubDate.toISOString()}>
                  {formatDate(pubDate)}
                </time>
              </>
            </>
          )
        }
      </p><h1>{title}</h1><p class="detail-description">{description}</p><ul
        class="tag-list"
        aria-label="Article topics"
      >
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    {
      backgroundImage && (
        <img
          class="detail-image"
          src={backgroundImage}
          alt={`${title} cover`}
          width="850"
          height="478"
        />
      )
    }
    <article class="prose dark:prose-invert article-prose"><slot /></article>
  </main>
  <Footer />
</Layout>
