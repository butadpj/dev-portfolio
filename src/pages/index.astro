---
import Layout from "../layouts/Root.astro";
import Navbar from "../sharedComponents/Navbar/Navbar";
import Hero from "../components/home/Hero";
import Work from "../components/home/Work.astro";
import About from "../components/home/About.astro";
import Writing from "../components/home/Writing.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const blogs = (await getCollection("blogs"))
  .filter((blog) => !blog.data.isDraft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Paul John Butad · AI Engineer & Founder">
  <Navbar client:load />
  <main id="main-content" tabindex="-1">
    <Hero />
    <Work projects={projects} />
    <About />
    <Writing blogs={blogs} />
  </main>
  <Footer />
</Layout>
